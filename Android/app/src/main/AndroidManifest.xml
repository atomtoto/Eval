<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Eval works offline: drop what Skip's libraries request for networking and tests. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <queries tools:node="remove" />
    <!-- « Scanner une formule » reads formulas on the device; the picture is neither kept nor sent. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:name=".EvalApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.Eval">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- The alternate launcher icons of « Icône de l’app » (Android 13+ enables one
             of them, as on iOS); disabled, they stay out of the launcher. -->
        <activity-alias
            android:name=".MainActivityIconPoint"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_point"
            android:roundIcon="@mipmap/ic_launcher_point"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".MainActivityIconBlue"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_blue"
            android:roundIcon="@mipmap/ic_launcher_blue"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".MainActivityIconPointBlue"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_point_blue"
            android:roundIcon="@mipmap/ic_launcher_point_blue"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
